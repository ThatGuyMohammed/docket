# Copy to .env and adjust. Everything here is optional for local use.

# Document signatures: ed25519 | ml-dsa-65 | rsa-pss-3072
DOC_SIGNING_ALG=ed25519
# DOC_SIGNING_KEY_PATH=/run/secrets/docket/signing.pem

# Login tokens: RS256 | ES256 | EdDSA
JWT_ALG=RS256
# JWT_PRIVATE_KEY_PATH=/run/secrets/docket/jwt.pem
JWT_TTL_MINUTES=60

# 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
DATA_KEY=

WEBHOOK_SECRET=change-me

# Nightly archive export
# ARCHIVE_BUCKET=my-docket-archive
# ARCHIVE_KMS_KEY_ID=alias/docket-archive
# ARCHIVE_KMS_SIGNING_ALG=RSASSA_PSS_SHA_256
# AWS_REGION=eu-west-1
